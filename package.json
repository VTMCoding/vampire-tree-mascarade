{
  "name": "vtm-lignages",
  "version": "1.0.3",
  "description": "Visualiseur/éditeur de lignages VTM",
  "main": "main.js",
  "author": "Swiiptz",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
  },
  "devDependencies": {
    "electron": "^29.4.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "fr.vtm.lignages",
    "productName": "Vampire Tree Mascarade",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "app/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    }
  }
}
